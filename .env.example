# ============================================================
# EduSync environment. Copy this file to ".env" and edit it.
#   PowerShell:  Copy-Item .env.example .env
# NEVER commit your real .env file.
# ============================================================

# ---- PostgreSQL ----
POSTGRES_USER=edusync
POSTGRES_PASSWORD=Ds@980826
POSTGRES_DB=edusync

# ---- Backend ----
# Used when you run the backend directly on your machine (not inside Docker).
# Docker Compose overrides DB_HOST automatically.
DB_HOST=localhost
DB_PORT=5432
PORT=5000
# Generate a secret:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=37f915655f734a21cdb18e964abde239f5d553d16724f4953050745783ed66ce27e6c4273ba547cda826ce73ae192bc4
JWT_EXPIRES_HOURS=8
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
# Cookie settings: for local use keep lax. For a deployed frontend on a DIFFERENT domain use
# COOKIE_SAMESITE=none and COOKIE_SECURE=true (HTTPS required).
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# Max students per group (members + pending invitations)
GROUP_MAX_SIZE=5

# ---- Initial administrator (created automatically on backend start) ----
ADMIN_NAME=Prof. Admin
ADMIN_EMAIL=admin@edusync.demo
ADMIN_PASSWORD=Admin@12345

# ---- Demo data (local development only) ----
# Password given to every demo student by the seed script.
DEMO_STUDENT_PASSWORD=Student@12345
# true = load demo data automatically when the database is empty (Docker Compose uses this)
SEED_ON_START=true
# Needed only to let `npm run seed` wipe and reload data inside the production-mode container
ALLOW_SEED_RESET=true
DATABASE_URL=postgresql://edusync:Ds@980826@db:5432/edusync